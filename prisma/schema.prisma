generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Attraction {
  id             String       @id
  name           String
  description    String
  image          String?
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Municipality   Municipality @relation(fields: [municipalityId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Event {
  id             String       @id
  title          String
  description    String
  date           DateTime
  image          String?
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Municipality   Municipality @relation(fields: [municipalityId], references: [id])
  EventImage     EventImage[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EventImage {
  id        String   @id
  url       String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Guide {
  id             String       @id
  name           String
  phone          String
  languages      String[]
  description    String?
  image          String?
  email          String?
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  active         Boolean      @default(false)
  Municipality   Municipality @relation(fields: [municipalityId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Highlight {
  id             String           @id
  title          String
  description    String?
  image          String?
  latitude       Float?
  longitude      Float?
  municipalityId String
  createdAt      DateTime         @default(now())
  Municipality   Municipality     @relation(fields: [municipalityId], references: [id])
  HighlightImage HighlightImage[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model HighlightImage {
  id          String    @id
  url         String
  highlightId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Municipality {
  id                String              @id
  name              String
  description       String?
  coatOfArms        String?
  latitude          Float?
  longitude         Float?
  about             String?
  slug              String?             @unique
  ibgeCode          String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  active            Boolean             @default(false)
  prefeito          String?
  gentilic          String?
  Attraction        Attraction[]
  Event             Event[]
  Guide             Guide[]
  Highlight         Highlight[]
  MunicipalityImage MunicipalityImage[]
  User              User[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MunicipalityImage {
  id             String       @id
  url            String
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Post {
  id         String   @id
  title      String
  content    String
  coverImage String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  slug       String   @unique
  subtitle   String?
  altText    String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id             String        @id
  clerkId        String?       @unique
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  password       String?
  image          String?       @default("/images/default-profile.png")
  municipalityId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Municipality   Municipality? @relation(fields: [municipalityId], references: [id])
}
