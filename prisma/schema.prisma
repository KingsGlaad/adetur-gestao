generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Attraction {
  id             String       @id @default(cuid())
  name           String
  description    String
  image          String?
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Municipality   Municipality @relation(fields: [municipalityId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Event {
  id             String       @id @default(cuid())
  title          String
  description    String
  date           DateTime
  image          String?
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Municipality   Municipality @relation(fields: [municipalityId], references: [id])
  galleryImages  EventImage[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EventImage {
  id        String   @id @default(cuid())
  url       String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Guide {
  id             String       @id @default(cuid())
  name           String
  phone          String
  languages      String[]
  description    String?
  image          String?
  email          String?
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  active         Boolean      @default(false)
  Municipality   Municipality @relation(fields: [municipalityId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Highlight {
  id             String           @id @default(cuid())
  title          String
  description    String?
  latitude       Float?
  longitude      Float?
  municipalityId String
  createdAt      DateTime         @default(now())
  image          String?
  Municipality   Municipality     @relation(fields: [municipalityId], references: [id])
  galleryImages  HighlightImage[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model HighlightImage {
  id          String    @id @default(cuid())
  url         String
  highlightId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Municipality {
  id          String              @id @default(cuid())
  name        String
  description String?
  coatOfArms  String?
  latitude    Float?
  longitude   Float?
  about       String?
  slug        String?             @unique
  ibgeCode    String?             @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  active      Boolean             @default(false)
  prefeito    String?
  gentilic    String?
  attractions Attraction[]
  events      Event[]
  guides      Guide[]
  highlights  Highlight[]
  images      MunicipalityImage[]
  users       User[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MunicipalityImage {
  id             String       @id @default(cuid())
  url            String
  municipalityId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Post {
  id         String   @id @default(cuid())
  title      String
  content    String
  coverImage String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  slug       String   @unique
  subtitle   String?
  altText    String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id             String        @id @default(cuid())
  clerkId        String?       @unique
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  password       String?
  image          String?       @default("/images/default-profile.png")
  municipalityId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  Municipality   Municipality? @relation(fields: [municipalityId], references: [id])
}

model Transparency {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String?
  date        DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
